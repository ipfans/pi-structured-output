{
  "name": "@ipfans/pi-structured-output",
  "version": "0.1.1",
  "description": "JSON Schema-validated structured output for the Pi coding agent CLI",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipfans/pi-structured-output.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "json-schema",
    "structured-output"
  ],
  "files": [
    "extensions/",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/structured-output.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "lint": "biome check . && tsc --noEmit",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.19.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
